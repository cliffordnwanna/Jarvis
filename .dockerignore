# Keep the build context lean — only what the backend image needs reaches Docker

# Git history
.git/
.gitignore

# Secrets — never bake into image
.env
.env.*
backend/google_credentials.json
backend/google_token.json

# Frontend — not needed for backend image (Vercel builds it)
frontend/

# Python caches
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Docs
docs/
archive/

# OS
.DS_Store
Thumbs.db
